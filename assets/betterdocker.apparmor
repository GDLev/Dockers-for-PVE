#include <tunables/global>

profile betterdocker-default flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (send,receive) peer=betterdocker-default,
  deny mount,
  deny /sys/** wklx,
  deny /proc/sys/** wklx,
  deny /proc/sysrq-trigger rwklx,
  deny /proc/kcore rwklx,
  deny /proc/{kallsyms,keys,sched_debug,timer_list} rwklx,
  deny /proc/*/{mem,root/**} rwklx,
  deny /etc/pve/** rwklx,
  deny /var/lib/betterdocker/** rwklx,
  deny /run/docker.sock rwklx,
  deny /run/user/*/docker.sock rwklx,
}
